{
  // STARTER profile - not yet tested in-game. Tune in Roadcraft.
  // Knob directions: clockwise = positive. Stick: +X right, +Y up.
  // Axes: LeftX LeftY RightX RightY LeftTrigger RightTrigger Triggers None
  // Buttons: A B X Y LeftShoulder RightShoulder Back Start Guide
  //          LeftThumb RightThumb DPadUp DPadDown DPadLeft DPadRight
  "name": "Roadcraft",

  "stick": {
    "x": { "axis": "LeftX" },
    "y": { "axis": "LeftY" },
    "deadzone": 0.08,
    "curve": 1.0,
    "antiDeadzone": 0.0
  },

  "buttons": {
    "Side1": "A",
    "Side2": "B",
    "Side3": "X",
    "Side4": "Y",
    "Side5": "LeftShoulder",
    "Side6": "RightShoulder",
    "Side7": "Back",
    "Side8": "Start",
    "DpadUp": "DPadUp",
    "DpadDown": "DPadDown",
    "DpadLeft": "DPadLeft",
    "DpadRight": "DPadRight",
    "BigKnobPress": "LeftThumb",
    "TopKnobPress": "RightThumb"
  },

  "knobs": {
    // Turning speed -> right stick; glides to a stop.
    "OuterRing": {
      "mode": "Rate",
      "axis": "RightX",
      "fullScaleTicksPerSecond": 10,
      "minTicksPerSecond": 0.75,
      "averageIntervals": 2,
      "ignoreSingleTicks": false,
      "curve": 1.0,
      "antiDeadzone": 0.0,
      "rampUpPerSecond": 4.0,
      "rampDownPerSecond": 2.0
    },
    "BigKnob": {
      "mode": "Rate",
      "axis": "RightY",
      "fullScaleTicksPerSecond": 10,
      "rampUpPerSecond": 4.0,
      "rampDownPerSecond": 2.0
    },
    // Each tick taps a shoulder button.
    "TopKnob": {
      "mode": "Buttons",
      "clockwise": "RightShoulder",
      "counterClockwise": "LeftShoulder",
      "pulseMilliseconds": 40
    }
  }
}
