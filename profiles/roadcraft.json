{
  // STARTER profile - not yet tested in-game. Tune in Roadcraft.
  // Knob directions: clockwise = positive. Stick: +X right, +Y up.
  // Axes: LeftX LeftY RightX RightY LeftTrigger RightTrigger Triggers None
  // Buttons: A B X Y LeftShoulder RightShoulder Back Start Guide
  //          LeftThumb RightThumb DPadUp DPadDown DPadLeft DPadRight
  "name": "Roadcraft",

  "stick": {
    "x": { "axis": "LeftX" },
    "y": { "axis": "LeftY" },
    "deadzone": 0.08,
    "curve": 1.0,
    "antiDeadzone": 0.0
  },

  "buttons": {
    "Side1": "A",
    "Side2": "B",
    "Side3": "X",
    "Side4": "Y",
    "Side5": "LeftShoulder",
    "Side6": "RightShoulder",
    "Side7": "Back",
    "Side8": "Start",
    "DpadUp": "DPadUp",
    "DpadDown": "DPadDown",
    "DpadLeft": "DPadLeft",
    "DpadRight": "DPadRight",
    "LargeKnobPress": "LeftThumb",
    "SmallKnobPress": "RightThumb"
  },

  "knobs": {
    // Rate mode: turning speed drives the axis; it glides to a stop.
    // Every Rate setting is shown here with its default; the other knobs
    // leave them out and get the same defaults.
    "DialRing": {
      "mode": "Rate",
      "axis": "RightX",
      "invert": false,
      "fullScaleTicksPerSecond": 15,  // turning this fast = full deflection
      "minTicksPerSecond": 0.75,      // slower than this = stopped
      "averageIntervals": 4,          // speed averaged over this many gaps
      "graceFactor": 2.5,             // hold speed until a tick is this many gaps late
      "smoothingSeconds": 0.25,       // output smoothing; 0 = none
      "ignoreSingleTicks": false,     // true = a lone stray tick does nothing
      "curve": 1.0,
      "antiDeadzone": 0.0,
      "rampUpPerSecond": 4.0,
      "rampDownPerSecond": 2.0
    },
    "LargeKnob": {
      "mode": "Rate",
      "axis": "RightY"
    },
    // Triggers: clockwise sweeps RT, counter-clockwise LT.
    // (joy.cpl shows both triggers as one "Z axis"; games see them separately.)
    // For taps instead: "mode": "Buttons", "clockwise": "RightShoulder",
    // "counterClockwise": "LeftShoulder", "pulseMilliseconds": 40
    "SmallKnob": {
      "mode": "Rate",
      "axis": "Triggers"
    }
  }
}
