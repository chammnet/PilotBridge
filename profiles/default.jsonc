// The generic profile, used when no profile is given on the command line.
// Setting explanations live in PilotBridge.Core/settings-help.jsonc; comments
// here are notes about this profile only.
{
  "formatVersion": 1,
  "name": "Default",
  "game": "",
  "description": "Generic starting point: joystick on the left stick, knobs on the right stick and triggers, side buttons on the face and shoulder buttons. Copy it and adjust for your game.",
  "author": "",

  "stick": {
    "x": { "axis": "LeftX" },
    "y": { "axis": "LeftY" },
    "deadzone": 0.08
  },

  "buttons": {
    "Side1": "A",
    "Side2": "B",
    "Side3": "X",
    "Side4": "Y",
    "Side5": "LeftShoulder",
    "Side6": "RightShoulder",
    "Side7": "Back",
    "Side8": "Start",
    "DpadUp": "DPadUp",
    "DpadDown": "DPadDown",
    "DpadLeft": "DPadLeft",
    "DpadRight": "DPadRight",
    "LargeKnobPress": "LeftThumb",
    "SmallKnobPress": "RightThumb"
    // TouchUp is left unmapped: with the XPPen app running it selects the
    // app's default layer.
  },

  "knobs": {
    "DialRing": {
      "mode": "Rate",
      "axis": "RightX"
    },
    "LargeKnob": {
      "mode": "Rate",
      "axis": "RightY"
    },
    // Clockwise = RT, counter-clockwise = LT (e.g. throttle / brake).
    "SmallKnob": {
      "mode": "Rate",
      "axis": "Triggers"
    }
  }
}
